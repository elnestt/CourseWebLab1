{
  "name": "pc-store-backend",
  "version": "1.0.0",
  "description": "Backend API для інформаційної системи комп'ютерної фірми",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/app.js",
    "start": "node --env-file=.env src/app.js",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "node --env-file=.env prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}